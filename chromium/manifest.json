{
  "manifest_version": 3,
  "name": "VidNote AI - 视频字幕与笔记",
  "description": "读取视频字幕，生成带时间戳的 AI 笔记，并导出为 Obsidian Media Extended 兼容 Markdown。",
  "version": "0.1.18",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "sidePanel",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://youtu.be/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 VidNote AI 侧边栏",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.youtube.com/watch*",
        "*://youtu.be/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://youtu.be/*"
      ],
      "js": ["src/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
