{
  "manifest_version": 3,
  "name": "VidNote AI - 视频字幕与笔记",
  "description": "读取视频字幕，生成带时间戳的 AI 笔记，并导出为 Obsidian Media Extended 兼容 Markdown。",
  "version": "0.1.17",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://youtu.be/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "打开 VidNote AI 侧边栏",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "VidNote AI",
    "default_panel": "src/sidepanel.html",
    "default_icon": "assets/icon-32.png",
    "open_at_install": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.youtube.com/watch*",
        "*://youtu.be/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://youtu.be/*"
      ],
      "js": ["src/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vidnote-ai@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  }
}
